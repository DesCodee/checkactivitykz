# GEMINI_API_KEY: Primary AI engine for OCR, multimodal compliance, and media analysis.
# In Google AI Studio: Injected automatically by the platform runtime.
# In Vercel: Add in Vercel Dashboard -> Project -> Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional secondary/fallback AI engine (GPT-4o-mini).
# If provided, automatically activates as an alternative or fallback if Gemini hits quota limits.
OPENAI_API_KEY="sk-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
